{
    "name": "n8n True 4-Agent Pipeline Workflow",
    "nodes": [
        {
            "parameters": {},
            "id": "chat-trigger",
            "name": "Chat Trigger",
            "type": "@n8n/n8n-nodes-langchain.chatTrigger",
            "typeVersion": 1,
            "position": [
                0,
                500
            ]
        },
        {
            "parameters": {
                "model": "llama3",
                "options": {}
            },
            "id": "ollama-model",
            "name": "Ollama Chat Model",
            "type": "@n8n/n8n-nodes-langchain.lmChatOllama",
            "typeVersion": 1,
            "position": [
                300,
                700
            ]
        },
        {
            "parameters": {
                "jsCode": "const { execSync } = require('child_process');\nconst instruction = $input.first().json.chatInput || 'Review changes';\nlet diff = '';\ntry {\n  diff = execSync('git diff HEAD', { cwd: '/home/joseph/five001/Agent5001' }).toString();\n} catch (e) { diff = 'Error: ' + e.message; }\n\n// We output chatInput so the next Agent reads it as the user prompt\nreturn { chatInput: `INSTRUCTION: ${instruction}\\n\\nGIT DIFF:\\n${diff}` };"
            },
            "id": "get-diff",
            "name": "Local Git Code Tool",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                200,
                500
            ]
        },
        {
            "parameters": {
                "agent": "conversationalAgent",
                "promptType": "default",
                "options": {
                    "systemMessage": "You are the REVIEWER AGENT. The user will provide an INSTRUCTION and a GIT DIFF. Read the diff carefully. Formulate a structured critique identifying any issues, areas for improvement, and categorize the risk level. Do not draft a PR, ONLY output the critique."
                }
            },
            "id": "reviewer-agent",
            "name": "Reviewer Agent",
            "type": "@n8n/n8n-nodes-langchain.agent",
            "typeVersion": 1,
            "position": [
                400,
                500
            ]
        },
        {
            "parameters": {
                "jsCode": "return { chatInput: `Based on this Reviewer Critique, draft a proper formatted Pull Request:\\n\\n${$input.first().json.output}` };"
            },
            "id": "format-step-1",
            "name": "Format For Writer",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                600,
                500
            ]
        },
        {
            "parameters": {
                "agent": "conversationalAgent",
                "promptType": "default",
                "options": {
                    "systemMessage": "You are the WRITER AGENT. The user will give you a code critique. Your only job is to draft a GitHub Pull Request using markdown format. You MUST include a Summary, Files Affected, Behavior Change, and a 'Test Plan' section. Do not include introductory text, just the Markdown PR."
                }
            },
            "id": "writer-agent",
            "name": "Writer Agent",
            "type": "@n8n/n8n-nodes-langchain.agent",
            "typeVersion": 1,
            "position": [
                800,
                500
            ]
        },
        {
            "parameters": {
                "jsCode": "return { chatInput: `CRITIQUE THE FOLLOWING PR DRAFT:\\n\\n${$input.first().json.output}` };"
            },
            "id": "format-step-2",
            "name": "Format For Gatekeeper",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                1000,
                500
            ]
        },
        {
            "parameters": {
                "agent": "conversationalAgent",
                "promptType": "default",
                "options": {
                    "systemMessage": "You are the GATEKEEPER AGENT. Evaluate the PR Draft. Does it contain sufficient detail and a proper 'Test Plan'? If it is poorly drafted, point out exactly what is missing and output 'FAIL' at the very end. If it is high quality and includes a Test Plan, you MUST output 'PASS' at the very end."
                }
            },
            "id": "gatekeeper-agent",
            "name": "Gatekeeper Agent",
            "type": "@n8n/n8n-nodes-langchain.agent",
            "typeVersion": 1,
            "position": [
                1200,
                500
            ]
        },
        {
            "parameters": {
                "conditions": {
                    "string": [
                        {
                            "value1": "={{ $json.output }}",
                            "operation": "contains",
                            "value2": "PASS"
                        }
                    ]
                }
            },
            "id": "if-pass",
            "name": "Did Gatekeeper PASS?",
            "type": "n8n-nodes-base.if",
            "typeVersion": 2,
            "position": [
                1400,
                500
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "https://api.github.com/repos/JosephSxhmo/Agent5001/pulls",
                "authentication": "predefinedCredentialType",
                "nodeCredentialType": "githubApi",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={\n  \"title\": \"Agent5001 Passed Reflected PR\",\n  \"body\": \"This draft passed Gatekeeper validation!\",\n  \"head\": \"my-new-feature\",\n  \"base\": \"main\"\n}",
                "options": {}
            },
            "id": "github-http-node",
            "name": "GitHub (Publish PR)",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.1,
            "position": [
                1600,
                400
            ]
        },
        {
            "parameters": {
                "jsCode": "return { chatInput: `The Gatekeeper FAILED your PR logic for this reason:\\n\\n${$input.first().json.output}\\n\\nPlease rewrite the PR draft!` };"
            },
            "id": "loop-back",
            "name": "Gatekeeper Failed (Loop back)",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                1600,
                600
            ]
        }
    ],
    "connections": {
        "Chat Trigger": {
            "main": [
                [
                    {
                        "node": "Local Git Code Tool",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Local Git Code Tool": {
            "main": [
                [
                    {
                        "node": "Reviewer Agent",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Reviewer Agent": {
            "main": [
                [
                    {
                        "node": "Format For Writer",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Format For Writer": {
            "main": [
                [
                    {
                        "node": "Writer Agent",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Writer Agent": {
            "main": [
                [
                    {
                        "node": "Format For Gatekeeper",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Format For Gatekeeper": {
            "main": [
                [
                    {
                        "node": "Gatekeeper Agent",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Gatekeeper Agent": {
            "main": [
                [
                    {
                        "node": "Did Gatekeeper PASS?",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Did Gatekeeper PASS?": {
            "main": [
                [
                    {
                        "node": "GitHub (Publish PR)",
                        "type": "main",
                        "index": 0
                    }
                ],
                [
                    {
                        "node": "Gatekeeper Failed (Loop back)",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Gatekeeper Failed (Loop back)": {
            "main": [
                [
                    {
                        "node": "Writer Agent",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Ollama Chat Model": {
            "ai_languageModel": [
                [
                    {
                        "node": "Reviewer Agent",
                        "type": "ai_languageModel",
                        "index": 0
                    }
                ],
                [
                    {
                        "node": "Writer Agent",
                        "type": "ai_languageModel",
                        "index": 0
                    }
                ],
                [
                    {
                        "node": "Gatekeeper Agent",
                        "type": "ai_languageModel",
                        "index": 0
                    }
                ]
            ]
        }
    },
    "settings": {
        "executionOrder": "v1"
    }
}