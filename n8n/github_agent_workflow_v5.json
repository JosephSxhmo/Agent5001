                    }
                ]
            ]
        },
        "Loop Back to Writer": {
            "main": [
                [
                    {
                        "node": "Writer Agent",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Trigger Webhook Wait Link": {
            "main": [
                [
                    {
                        "node": "Wait for Approval (Webhook)",
                        "type": "main",
