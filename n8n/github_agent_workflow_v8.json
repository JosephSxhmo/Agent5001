{
    "name": "n8n True 4-Agent Pipeline Workflow V8 (Chat Approval)",
    "nodes": [
        {
            "parameters": {},
            "id": "trigger-chat",
            "name": "Chat Trigger",
            "type": "@n8n/n8n-nodes-langchain.chatTrigger",
            "typeVersion": 1,
            "position": [
                0,
                460
            ]
        },
        {
            "parameters": {
                "model": "llama3",
                "options": {}
            },
            "id": "model-ollama",
            "name": "Ollama Model",
            "type": "@n8n/n8n-nodes-langchain.lmChatOllama",
            "typeVersion": 1,
            "position": [
                360,
                680
            ]
        },
        {
            "parameters": {
                "jsCode": "const { execSync } = require('child_process');\nconst fs = require('fs');\nconst instruction = $input.first().json.chatInput || '';\nlet diff = '';\n\n// Check if this is an explicit APPROVAL command instead of a request to generate a draft\nif (instruction.toLowerCase().trim() === 'approve') {\n  let saved_draft = '';\n  try {\n    saved_draft = fs.readFileSync('/home/joseph/five001/Agent5001/pending_draft.md', 'utf8');\n  } catch(e) {}\n  return { instruction: 'APPROVE', chatInput: 'APPROVE', savedData: saved_draft };\n}\n\ntry {\n  diff = execSync('git diff HEAD', { cwd: '/home/joseph/five001/Agent5001' }).toString();\n  if (!diff) diff = 'No code changes in working directory.';\n} catch (e) { diff = 'Error fetching diff: ' + e.message; }\n\nreturn { instruction: instruction, diff: diff, chatInput: `INSTRUCTION: ${instruction}\\n\\nDATA:\\n${diff}` };"
            },
            "id": "fetch-data",
            "name": "Initialization & Routing",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                200,
                460
            ]
        },
        {
            "parameters": {
                "promptType": "define",
                "text": "={{ $json.chatInput }}",
                "messages": {
                    "messageValues": [
                        {
                            "message": "You are the PLANNER AGENT. Analyze the user instruction. If the user said EXACTLY 'APPROVE', output 'EXECUTE_APPROVAL'. Otherwise, decide whether to create a Pull Request ('CREATE_PR'), create an Issue ('CREATE_ISSUE'), or take 'NO_ACTION'. You must output EXACTLY ONE of those four keywords and nothing else! Example: 'CREATE_PR'"
                        }
                    ]
                }
            },
            "id": "planner-agent",
            "name": "Planner Agent (Action Router)",
            "type": "@n8n/n8n-nodes-langchain.chainLlm",
            "typeVersion": 1.4,
            "position": [
                400,
                460
            ]
        },
        {
            "parameters": {
                "dataType": "string",
                "value1": "={{ $json.text }}",
                "rules": {
                    "rules": [
                        {
                            "operation": "contains",
                            "value2": "CREATE_PR",
                            "output": 0
                        },
                        {
                            "operation": "contains",
                            "value2": "CREATE_ISSUE",
                            "output": 1
                        },
                        {
                            "operation": "contains",
                            "value2": "NO_ACTION",
                            "output": 2
                        },
                        {
                            "operation": "contains",
                            "value2": "EXECUTE_APPROVAL",
                            "output": 3
                        }
                    ]
                }
            },
            "id": "planner-switch",
            "name": "Planner Switch Router",
            "type": "n8n-nodes-base.switch",
            "typeVersion": 1,
            "position": [
                620,
                460
            ]
        },
        {
            "parameters": {
                "jsCode": "return { chatInput: `Aborting cleanly! The Planner determined no GitHub action was required based on your instruction.` };"
            },
            "id": "planner-abort",
            "name": "Abort Successfully",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                620,
                240
            ]
        },
        {
            "parameters": {
                "jsCode": "const prev = $item(0).$node['Initialization & Routing'].json;\nreturn { chatInput: `PLANNER ACTION: ${$item(0).$node['Planner Agent (Action Router)'].json.text}\\nINSTRUCTION: ${prev.instruction}\\nDATA:\\n${prev.diff}` };"
            },
            "id": "format-reviewer",
            "name": "Format For Reviewer",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                840,
                460
            ]
        },
        {
            "parameters": {
                "promptType": "define",
                "text": "={{ $json.chatInput }}",
                "messages": {
                    "messageValues": [
                        {
                            "message": "You are the REVIEWER AGENT. Analyze the data and instructions. Categorize the change (feature, bugfix, refactor) and assess risk (low/medium/high). Identify potential issues. Output a structured critique summarizing your findings. Do not draft the final PR or Issue yet."
                        }
                    ]
                }
            },
            "id": "reviewer-agent",
            "name": "Reviewer Agent",
            "type": "@n8n/n8n-nodes-langchain.chainLlm",
            "typeVersion": 1.4,
            "position": [
                1060,
                460
            ]
        },
        {
            "parameters": {
                "jsCode": "const planner_action = $item(0).$node['Planner Agent (Action Router)'].json.text;\nconst prev = $item(0).$node['Initialization & Routing'].json.instruction;\nreturn { chatInput: `You are instructed to ${planner_action} matching user instructions '${prev}'.\\n\\nBased on this Reviewer Critique, draft the final markdown:\\n\\n${$input.first().json.text}` };"
            },
            "id": "format-writer",
            "name": "Format For Writer",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                1280,
                460
            ]
        },
        {
            "parameters": {
                "promptType": "define",
                "text": "={{ $json.chatInput }}",
                "messages": {
                    "messageValues": [
                        {
                            "message": "You are the WRITER AGENT. Draft the markdown content based purely on the critique provided. If CREATE_ISSUE, you MUST include 'Title', 'Problem description', 'Evidence', 'Acceptance criteria', and 'Risk level'. If CREATE_PR, you MUST include 'Title', 'Summary', 'Files affected', 'Behavior change', 'Test plan', and 'Risk level'. Output ONLY the markdown draft."
                        }
                    ]
                }
            },
            "id": "writer-agent",
            "name": "Writer Agent",
            "type": "@n8n/n8n-nodes-langchain.chainLlm",
            "typeVersion": 1.4,
            "position": [
                1500,
                460
            ]
        },
        {
            "parameters": {
                "jsCode": "return { chatInput: `CRITIQUE THE FOLLOWING PR/ISSUE DRAFT:\\n\\n${$input.first().json.text}` };"
            },
            "id": "format-gatekeeper",
            "name": "Format For Gatekeeper",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                1720,
                460
            ]
        },
        {
            "parameters": {
                "promptType": "define",
                "text": "={{ $json.chatInput }}",
                "messages": {
                    "messageValues": [
                        {
                            "message": "You are the GATEKEEPER AGENT. Check the draft for unsupported claims, missing evidence, missing test plans, or policy violations. If it is poor quality, point out what is missing and output 'FAIL' at the very end. If it meets all strict criteria, you MUST output 'PASS' at the very end."
                        }
                    ]
                }
            },
            "id": "gatekeeper-agent",
            "name": "Gatekeeper (Critic) Agent",
            "type": "@n8n/n8n-nodes-langchain.chainLlm",
            "typeVersion": 1.4,
            "position": [
                1940,
                460
            ]
        },
        {
            "parameters": {
                "dataType": "string",
                "value1": "={{ $json.text }}",
                "rules": {
                    "rules": [
                        {
                            "operation": "contains",
                            "value2": "PASS",
                            "output": 0
                        },
                        {
                            "operation": "contains",
                            "value2": "FAIL",
                            "output": 1
                        }
                    ]
                }
            },
            "id": "gatekeeper-switch",
            "name": "Gatekeeper Switch Router",
            "type": "n8n-nodes-base.switch",
            "typeVersion": 1,
            "position": [
                2160,
                460
            ]
        },
        {
            "parameters": {
                "jsCode": "return { chatInput: `GATEKEEPER REJECTED THE PREVIOUS DRAFT. Reason:\\n${$input.first().json.text}\\n\\nPlease rewrite the formatted draft to fix these specific issues!` };"
            },
            "id": "gatekeeper-loop",
            "name": "Loop Back to Writer",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                1800,
                240
            ]
        },
        {
            "parameters": {
                "jsCode": "const fs = require('fs');\nconst draft = $item(0).$node['Writer Agent'].json.text;\n\n// Save locally to simulate State\ntry {\n  fs.writeFileSync('/home/joseph/five001/Agent5001/pending_draft.md', draft);\n} catch(e) {}\n\nreturn { \n  text: `✅ GATEKEEPER PASSED THE DRAFT! \\n\\nI have saved the pending draft. Please review it below. \\nIf it looks good, just reply with the word \"Approve\" here in the chat to publish it to GitHub! \\n\\n---\\n\\n${draft}`\n};"
            },
            "id": "save-draft",
            "name": "Save Draft pending Approval",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                2380,
                460
            ]
        },
        {
            "parameters": {
                "jsCode": "const draft = $item(0).$node['Initialization & Routing'].json.savedData;\n\nif (!draft) {\n  return { error: 'No pending draft found. Run a review command first!' };\n}\n\nlet title = 'Agent5001 n8n Automated Creation';\nif (draft.includes('Title:')) {\n  title = draft.split('Title:')[1].split('\\n')[0].trim();\n}\n\nreturn {\n  title: title,\n  body: draft\n};"
            },
            "id": "format-github",
            "name": "Execute Approved Push",
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                2600,
                680
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "https://api.github.com/repos/JosephSxhmo/Agent5001/pulls",
                "authentication": "predefinedCredentialType",
                "nodeCredentialType": "githubApi",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={\n  \"title\": \"{{ $json.title }}\",\n  \"body\": \"{{ $json.body }}\",\n  \"head\": \"my-new-feature\",\n  \"base\": \"main\"\n}",
                "options": {}
            },
            "id": "github-http",
            "name": "GitHub (Create on Repo)",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.1,
            "position": [
                2820,
                680
            ]
        }
    ],
