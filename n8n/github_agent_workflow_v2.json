{
    "name": "n8n Multi-Agent GitHub Workflow v2",
    "nodes": [
        {
            "parameters": {},
            "id": "chat-trigger",
            "name": "Chat Trigger",
            "type": "@n8n/n8n-nodes-langchain.chatTrigger",
            "typeVersion": 1,
            "position": [
                200,
                300
            ]
        },
        {
            "parameters": {
                "model": "llama3",
                "options": {}
            },
            "id": "ollama-model",
            "name": "Ollama Chat Model",
            "type": "@n8n/n8n-nodes-langchain.lmChatOllama",
            "typeVersion": 1,
            "position": [
                400,
                500
            ]
        },
        {
            "parameters": {
                "agent": "conversationalAgent",
                "promptType": "default",
                "options": {
                    "systemMessage": "You are a multi-agent GitHub Repository Assistant. You have access to tools to review local Git changes, draft highly structured Pull Requests/Issues, and send them for Human Approval before publishing to GitHub.\n\nRULES:\n1. If asked to 'review', use the Git Tool to get the diff. \n2. If asked to 'draft a PR', you MUST use the Writer Tool to format it.\n3. After formatting, stop and ask the user for approval.\n4. If approved, use the GitHub HTTP Request to publish it. Make sure you pass 'title' and 'body'!"
                }
            },
            "id": "planner-agent",
            "name": "GitHub Multi-Agent (Planner)",
            "type": "@n8n/n8n-nodes-langchain.agent",
            "typeVersion": 1,
            "position": [
                400,
                300
            ]
        },
        {
            "parameters": {
                "name": "git_review_tool",
                "description": "Executes git diff HEAD to get the latest local code changes.",
                "jsCode": "return `Dummy diff for testing:\\n+ # Just testing the beautiful n8n bot!\\n`;"
            },
            "id": "git-diff-tool",
            "name": "Git Review Tool",
            "type": "@n8n/n8n-nodes-langchain.toolCustom",
            "typeVersion": 1,
            "position": [
                550,
                500
            ]
        },
        {
            "parameters": {
                "name": "draft_github_pr",
                "description": "Call this tool to format a draft Pull Request after reviewing the code. Requires the title and markdown body as inputs.",
                "jsCode": "const title = $input.item.json.title;\nconst body = $input.item.json.body;\nif (!body.includes('Test Plan')) {\n  return 'GATEKEEPER FAIL: The draft MUST contain a Test Plan before proceeding. Redraft it.';\n}\nreturn `GATEKEEPER PASS: Draft is ready for human approval.\\nTitle: ${title}\\n\\n${body}`;"
            },
            "id": "writer-gatekeeper-tool",
            "name": "Writer & Gatekeeper Tool",
            "type": "@n8n/n8n-nodes-langchain.toolCustom",
            "typeVersion": 1,
            "position": [
                700,
                500
            ]
        },
        {
            "parameters": {
                "method": "POST",
                "url": "https://api.github.com/repos/JosephSxhmo/Agent5001/pulls",
                "authentication": "predefinedCredentialType",
                "nodeCredentialType": "githubApi",
                "sendBody": true,
                "specifyBody": "json",
                "jsonBody": "={\n  \"title\": \"{{ $json.title || 'Agent 5001 n8n Pull Request' }}\",\n  \"body\": \"{{ $json.body }}\",\n  \"head\": \"my-new-feature\",\n  \"base\": \"main\"\n}",
                "options": {}
            },
            "id": "github-http-node",
            "name": "GitHub HTTP Request",
            "type": "n8n-nodes-base.httpRequest",
            "typeVersion": 4.1,
            "position": [
                850,
                500
            ]
        }
    ],
    "connections": {
        "Chat Trigger": {
            "main": [
                [
                    {
                        "node": "GitHub Multi-Agent (Planner)",
                        "type": "main",
                        "index": 0
                    }
                ]
            ]
        },
        "Ollama Chat Model": {
            "ai_languageModel": [
                [
                    {
                        "node": "GitHub Multi-Agent (Planner)",
                        "type": "ai_languageModel",
                        "index": 0
                    }
                ]
            ]
        },
        "Git Review Tool": {
            "ai_tool": [
                [
                    {
                        "node": "GitHub Multi-Agent (Planner)",
                        "type": "ai_tool",
                        "index": 0
                    }
                ]
            ]
        },
        "Writer & Gatekeeper Tool": {
            "ai_tool": [
                [
                    {
                        "node": "GitHub Multi-Agent (Planner)",
                        "type": "ai_tool",
                        "index": 0
                    }
                ]
            ]
        },
        "GitHub HTTP Request": {
            "ai_tool": [
                [
                    {
                        "node": "GitHub Multi-Agent (Planner)",
                        "type": "ai_tool",
                        "index": 0
                    }
                ]
            ]
        }
    },
    "settings": {
        "executionOrder": "v1"
    }
}